@model List<VetKlinikSistemi.Models.Entities.Klinik>
@{
    ViewData["Title"] = "Klinikler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0">Klinik Yönetimi</h2>
    <a asp-action="Ekle" class="btn btn-primary">+ Yeni Klinik Ekle</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Sistemde henüz kayıtlı klinik bulunmuyor. Yukarıdaki butondan ilk kliniği ekleyebilirsiniz.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle bg-white shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Klinik Adı</th>
                    <th>Adres</th>
                    <th>Telefon</th>
                    <th>Çalışma Günleri</th>
                    <th>Çalışma Saatleri</th>
                    <th class="text-center" style="width: 180px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var klinik in Model)
                {
                    <tr>
                        <td class="fw-semibold">@klinik.Ad</td>
                        <td>@klinik.Adres</td>
                        <td>@klinik.Telefon</td>
                        <td>@klinik.CalismaGunleri</td>
                        <td>@klinik.AcilisSaati.ToString(@"hh\:mm") - @klinik.KapanisSaati.ToString(@"hh\:mm")</td>
                        <td class="text-center">
                            <a asp-action="Duzenle" asp-route-id="@klinik.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <form asp-action="Sil" asp-route-id="@klinik.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu kliniği silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}