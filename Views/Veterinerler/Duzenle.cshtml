@model VetKlinikSistemi.Models.ViewModels.VeterinerDuzenleViewModel
@using VetKlinikSistemi.Models.Entities
@{
    ViewData["Title"] = "Veteriner Düzenle";
    var uzmanliklar = ViewBag.Uzmanliklar as List<UzmanlikAlani> ?? new List<UzmanlikAlani>();
    var hizmetler = ViewBag.Hizmetler as List<Hizmet> ?? new List<Hizmet>();
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark fw-semibold">
                Veteriner Hekim Bilgilerini Düzenle
            </div>
            <div class="card-body">
                <form asp-action="Duzenle" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AdSoyad" class="form-label"></label>
                            <input asp-for="AdSoyad" class="form-control" />
                            <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="KlinikId" class="form-label"></label>
                            <select asp-for="KlinikId" class="form-select" asp-items="ViewBag.Klinikler">
                                <option value="">-- Klinik Seçiniz --</option>
                            </select>
                            <span asp-validation-for="KlinikId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Unvan" class="form-label"></label>
                        <input asp-for="Unvan" class="form-control" />
                        <span asp-validation-for="Unvan" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Biyografi" class="form-label"></label>
                        <textarea asp-for="Biyografi" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Biyografi" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Uzmanlık Alanları</label>
                        <div class="border rounded p-2">
                            <div class="row">
                                @foreach (var u in uzmanliklar)
                                {
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SeciliUzmanlikIdleri" value="@u.Id" id="uzm_@u.Id"
                                                   @(Model.SeciliUzmanlikIdleri.Contains(u.Id) ? "checked" : "") />
                                            <label class="form-check-label" for="uzm_@u.Id">@u.Ad</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Verebildiği Hizmetler</label>
                        <div class="border rounded p-2">
                            <div class="row">
                                @foreach (var h in hizmetler)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SeciliHizmetIdleri" value="@h.Id" id="hiz_@h.Id"
                                                   @(Model.SeciliHizmetIdleri.Contains(h.Id) ? "checked" : "") />
                                            <label class="form-check-label" for="hiz_@h.Id">
                                                @h.Ad <span class="text-muted small">(@h.Klinik?.Ad)</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                        <button type="submit" class="btn btn-warning">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}