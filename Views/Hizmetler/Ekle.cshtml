@model VetKlinikSistemi.Models.Entities.Hizmet
@{
    ViewData["Title"] = "Yeni Hizmet Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white fw-semibold">
                Yeni Hizmet Ekle
            </div>
            <div class="card-body">
                <form asp-action="Ekle" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="KlinikId" class="form-label"></label>
                        <select asp-for="KlinikId" class="form-select" asp-items="ViewBag.Klinikler">
                            <option value="">-- Klinik Seçiniz --</option>
                        </select>
                        <span asp-validation-for="KlinikId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ad" class="form-label"></label>
                        <input asp-for="Ad" class="form-control" placeholder="Örn: Genel Muayene, Karma Aşı, Diş Temizliği" />
                        <span asp-validation-for="Ad" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Aciklama" class="form-label"></label>
                        <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SureDakika" class="form-label"></label>
                            <input asp-for="SureDakika" type="number" min="5" max="480" class="form-control" />
                            <span asp-validation-for="SureDakika" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Ucret" class="form-label"></label>
                            <input asp-for="Ucret" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="Ucret" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                        <button type="submit" class="btn btn-success">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}