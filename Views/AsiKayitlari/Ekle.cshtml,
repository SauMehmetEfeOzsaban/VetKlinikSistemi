@model VetKlinikSistemi.Models.ViewModels.AsiKaydiFormViewModel
@{
    ViewData["Title"] = "Yeni Aşı Kaydı";
}

<h2 class="mb-3">Yeni Aşı Kaydı Ekle</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Ekle" method="post" class="card p-4 shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="EvcilHayvanId" class="form-label"></label>
                <select asp-for="EvcilHayvanId" asp-items="ViewBag.EvcilHayvanlar" class="form-select">
                    <option value="">-- Evcil Hayvan Seçiniz --</option>
                </select>
                <span asp-validation-for="EvcilHayvanId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AsiAdi" class="form-label"></label>
                <input asp-for="AsiAdi" class="form-control" placeholder="Örn: Kuduz Aşısı, Karma Aşı" />
                <span asp-validation-for="AsiAdi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="YapildigiTarih" class="form-label"></label>
                <input asp-for="YapildigiTarih" type="date" class="form-control" />
                <span asp-validation-for="YapildigiTarih" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SonrakiDozTarihi" class="form-label"></label>
                <input asp-for="SonrakiDozTarihi" type="date" class="form-control" />
                <span asp-validation-for="SonrakiDozTarihi" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}